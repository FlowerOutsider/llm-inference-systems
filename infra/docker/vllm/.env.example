VLLM_IMAGE=vllm/vllm-openai:v0.8.5
PROMETHEUS_IMAGE=prom/prometheus:v3.0.1

VLLM_HOST_PORT=8002
PROMETHEUS_HOST_PORT=9090

MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
SERVED_MODEL_NAME=qwen2.5-0.5b
DTYPE=half

GPU_MEMORY_UTILIZATION=0.70
MAX_MODEL_LEN=2048
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=2048

PREFIX_CACHE_HASH_ALGO=sha256
HF_HUB_OFFLINE=1

# Relative to infra/docker/vllm/compose.yaml.
HF_CACHE_DIR=../../../.cache/huggingface


GRAFANA_IMAGE=grafana/grafana:11.4.0
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-your-local-env